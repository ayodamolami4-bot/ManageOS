# Local environment only. Never commit real credentials or tokens.
NODE_ENV=development
PORT=5000
# For managed PostgreSQL in deployment, use DATABASE_URL instead of DB_*:
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# (Set real credentials privately in Render; never commit them.)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=manageos
DB_USER=manageos
DB_PASSWORD=change_me

# Transactional email. Nothing sends until the selected provider is fully
# configured. For no-domain and no Cloud Billing, use 'apps_script' with the
# separate Google Apps Script sender. 'gmail' uses Gmail API OAuth; 'resend'
# requires a verified sending domain. Do NOT paste secrets in chat.
# See docs/GMAIL_EMAIL_SETUP.md for the Gmail API authorization limitations.
# See docs/APPS_SCRIPT_EMAIL_SETUP.md for the free alternative.
EMAIL_PROVIDER=resend
# Resend (requires verified sending domain):
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Apps Script MailApp HTTPS bridge (set EMAIL_PROVIDER=apps_script):
# APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
# APPS_SCRIPT_SHARED_SECRET=your_long_random_base64url_secret
# Gmail HTTPS API (set EMAIL_PROVIDER=gmail to enable this provider):
# GMAIL_SENDER_EMAIL=your-authorized-gmail-address@gmail.com
# GMAIL_OAUTH_CLIENT_ID=private_google_oauth_client_id
# GMAIL_OAUTH_CLIENT_SECRET=store_privately
# GMAIL_OAUTH_REFRESH_TOKEN=store_privately
PUBLIC_APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# One-origin production deployment:
# Render serves /api and the built React app on the same HTTPS hostname.
# Set PUBLIC_APP_URL=https://your-service.onrender.com in Render.
# Leave FRONTEND_URL unset when the frontend uses that same origin.
# Frontend VITE_API_BASE_URL can be omitted; it defaults to /api.
# The existing local development Vite proxy maps /api to localhost:5000.

# File storage backend.
# Development/test defaults to "local"; production defaults to "supabase"
# and refuses ephemeral local files. Use a PRIVATE manageos-files bucket.
# The sb_secret_ key bypasses storage RLS; never expose it to browsers or git.
# FILE_STORAGE_BACKEND=supabase
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_STORAGE_BUCKET=manageos-files
# SUPABASE_SECRET_KEY=store_privately_in_render_or_github_actions_secrets
#
# Optional legacy Cloudflare R2 backend if explicitly configured later:
# FILE_STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_API_TOKEN=
